APP_VERSION=latest
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_WITH_openssl_rand_-base64_32
APP_URL=https://snipeit.jkdeleon.net
APP_TIMEZONE=Asia/Qatar
APP_LOCALE=en-US

DB_CONNECTION=mariadb
DB_HOST=<rds-endpoint>
DB_PORT=3306
DB_DATABASE=snipeit
DB_USERNAME=snipeit_admin
DB_PASSWORD='CHANGE_ME'
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

DB_SSL=true
DB_SSL_IS_PAAS=true
DB_SSL_CA_PATH=/etc/ssl/rds/global-bundle.pem
DB_SSL_VERIFY_SERVER=true

APP_TRUSTED_PROXIES=172.16.0.0/12
APP_TRUSTED_HEADERS=HEADER_X_FORWARDED_FOR,HEADER_X_FORWARDED_HOST,HEADER_X_FORWARDED_PROTO
SECURE_COOKIES=true

# Caddy: IP allowed on the web UI hostname (read by Caddy, not Snipe-IT)
ADMIN_IP=<admin-public-ip>/32

PRIVATE_FILESYSTEM_DISK=local
PUBLIC_FILESYSTEM_DISK=local_public
IMAGE_LIB=gd
MAIL_MAILER=log
LOG_CHANNEL=stderr
