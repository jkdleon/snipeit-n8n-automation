      "parameters": {
        "jsCode": "const p = $input.first().json.body.payload;\nconst m = /^(checkout|checkin):asset-(\\d+):log-(\\d+)$/.exec(p.externalId || '');\nif (!m) return [];\nconst recipients = p.recipients || [];\nconst rejecter = recipients.find(r => r.signingStatus === 'REJECTED') || {};\nconst notify = recipients.filter(r => r.email && r.email !== rejecter.email).map(r => r.email);\nreturn [{ json: {\n  type: m[1],\n  assetId: Number(m[2]),\n  title: p.title,\n  rejectedBy: `${rejecter.name || 'unknown'} <${rejecter.email || ''}>`,\n  reason: rejecter.rejectionReason || '(no reason given)',\n  notifyTo: (notify.length ? notify : ['it-admin@example.com']).join(','),\n} }];"
      },
