    {
      "parameters": {
        "jsCode": "const CONFIG = {\n  checkout: { envelopeId: 'envelope_bevvhdbxmyucxmvz', employeeRecipientId: 3709840, itRecipientId: 3709839,\n    fields: { asset_tag: 18376052, asset_model: 18376054, asset_serial: 18376053, event_date: 18376055 } },\n  checkin:  { envelopeId: 'envelope_vebezsuleweowkaf', employeeRecipientId: 3709844, itRecipientId: 3709845,\n    fields: { asset_tag: 18375984, asset_model: 18375985, asset_serial: 18375986, event_date: 18375987 } },\n};\n\nconst ev = $('Skip duplicates').first().json;\nconst asset = $('Get asset').first().json;\nconst user = $('Get user').first().json;\nconst admin = $('Get admin').first().json;\nconst cfg = CONFIG[ev.type];\n\nif (!user.email) throw new Error(`Employee ${user.name} (id ${user.id}) has no email in Snipe-IT`);\nif (!admin.email) throw new Error(`IT admin ${admin.name} (id ${admin.id}) has no email in Snipe-IT`);\n\nconst today = new Date().toISOString().slice(0, 10);\nconst values = {\n  asset_tag: asset.asset_tag,\n  asset_model: asset.model?.name ?? '',\n  asset_serial: asset.serial ?? '',\n  event_date: today,\n};\n\nconst payload = {\n  envelopeId: cfg.envelopeId,\n  externalId: ev.externalId,\n  distributeDocument: true,\n  recipients: [\n    { id: cfg.employeeRecipientId, email: user.email, name: user.name, signingOrder: 1 },\n    { id: cfg.itRecipientId, email: admin.email, name: admin.name, signingOrder: 2 },\n  ],\n  prefillFields: Object.entries(cfg.fields).map(([key, id]) => ({ id, type: 'text', value: String(values[key]) })),\n  override: {\n    title: `${ev.type === 'checkout' ? 'Asset Assignment' : 'Asset Return'} – ${asset.asset_tag} – ${user.name}`,\n  },\n};\n\nreturn [{ json: { ...ev, assetTag: asset.asset_tag, employeeName: user.name, payloadJson: JSON.stringify(payload) } }];"
      },
