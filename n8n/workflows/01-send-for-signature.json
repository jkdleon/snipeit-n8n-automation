    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst text = body.text || '';\nconst att = (body.attachments || [])[0] || {};\n\nlet type = null;\nif (text.includes('Asset checked out')) type = 'checkout';\nelse if (text.includes('Asset checked in')) type = 'checkin';\n\nconst assetMatch = (att.title_link || '').match(/\\/hardware\\/(\\d+)/);\nif (!type || !assetMatch) return [];\n\nconst toField = (att.fields || []).find(f => f.title === 'To');\nconst toMatch = toField ? String(toField.value).match(/\\/users\\/(\\d+)/) : null;\n\nreturn [{ json: {\n  type,\n  assetId: Number(assetMatch[1]),\n  webhookUserId: toMatch ? Number(toMatch[1]) : null,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "1804b2e3-6912-49eb-87f0-4646e6078436",
      "name": "Parse event"
    },
    {
      "parameters": {
        "jsCode": "const ev = $('Parse event').first().json;\nconst log = ($input.first().json.rows || [])[0];\nconst expected = ev.type === 'checkout' ? 'checkout' : 'checkin from';\n\nif (!log || log.action_type !== expected) return [];\nif (!log.target || log.target.type !== 'user') return [];\nif (ev.type === 'checkout' && log.target.id !== ev.webhookUserId) return [];\nif (!log.created_by) return [];\n\nreturn [{ json: {\n  ...ev,\n  userId: log.target.id,\n  adminId: log.created_by.id,\n  logId: log.id,\n  externalId: `${ev.type}:asset-${ev.assetId}:log-${log.id}`,\n} }];"
      },
