        "jsCode": "const DAYS = 3;\nconst cutoff = Date.now() - DAYS * 24 * 60 * 60 * 1000;\nconst overdue = ($input.first().json.data || [])\n  .filter(e => /^(checkout|checkin):asset-\\d+:log-\\d+$/.test(e.externalId || ''))\n  .filter(e => new Date(e.createdAt).getTime() < cutoff);\nif (overdue.length === 0) return [];\nconst lines = overdue.map(e => `- ${e.title} (sent ${e.createdAt.slice(0, 10)})`).join('\\n');\nreturn [{ json: { count: overdue.length, lines } }];"
