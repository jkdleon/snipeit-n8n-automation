    {
      "parameters": {
        "jsCode": "const ev = $('Parse externalId').first().json;\nconst tag = $input.first().json.asset_tag;\n// Match the employee by signingOrder: the API doesn't return recipients in signing order.\nconst employee = ($('Get envelope').first().json.recipients || []).find(r => r.signingOrder === 1) || {};\nconst safeName = (employee.name || 'unknown').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');\nconst fileName = `${ev.date}_${ev.type}_${safeName}.pdf`;\nconst pdf = $('Download signed PDF').first().binary.data;\nreturn [{\n  json: { ...ev, assetTag: tag, fileName },\n  binary: { data: { ...pdf, fileName } },\n}];"
      },
