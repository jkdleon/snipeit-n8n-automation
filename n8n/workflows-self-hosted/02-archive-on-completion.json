        "jsCode": "const p = $input.first().json.body.payload;\nconst m = /^(checkout|checkin):asset-(\\d+):log-(\\d+)$/.exec(p.externalId || '');\nif (!m) return [];\n// Name the archive by when the document was completed, in the business timezone.\nconst done = p.completedAt ? DateTime.fromISO(p.completedAt) : $now;\nreturn [{ json: {\n  type: m[1],\n  assetId: Number(m[2]),\n  envelopeId: p.envelopeId,\n  date: done.setZone('Asia/Qatar').toISODate(),\n} }];"
